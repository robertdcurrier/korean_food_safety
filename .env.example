# Copy to .env and fill in, or export these in your shell.
# Never commit .env.

# Anthropic API key. Without it the pipeline still runs; the AI
# enrichment step is skipped and the report shows Korean-only data.
ANTHROPIC_API_KEY=

# MFDS 식품안전나라 open API key. Without it the literal key "sample"
# is used, which returns the same 5 rows per service. Get a free key:
# https://www.foodsafetykorea.go.kr/api/ -> 인증키 신청
MFDS_API_KEY=

# Optional. Claude model for enrichment (default claude-opus-5-5).
# KFS_MODEL=claude-opus-5-5
